# PoolBerry VPS environment configuration
# Copy to .env on the deployment host and provide real values there.

POSTGRES_DB=poolberry
POSTGRES_USER=poolberry
POSTGRES_PASSWORD=change-me

# Main Pico identity
POOLBERRY_DEVICE_ID=poolberry-main-001

# Store only the SHA-256 hash of the Pico bearer token on the VPS.
# Generate a token and hash during deployment; never commit the real token.
POOLBERRY_DEVICE_TOKEN_SHA256=replace-with-sha256-hash

# Canonical public URL used for browser redirects behind Caddy.
POOLBERRY_PUBLIC_URL=https://config.kerssing.nl

# Web login.
# Generate POOLBERRY_AUTH_PASSWORD_SCRYPT during deployment; never store the
# plaintext password in this file. Format: scrypt:<salt-hex>:<hash-hex>
POOLBERRY_AUTH_USERNAME=martijn
POOLBERRY_AUTH_PASSWORD_SCRYPT=scrypt:replace-with-salt-hex:replace-with-hash-hex
POOLBERRY_AUTH_SESSION_SECRET=replace-with-long-random-secret
